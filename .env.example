# Public frontend values. Database credentials belong in the PHP configuration.
VITE_CANONICAL_URL=https://hd.zestbd.com/
# Same-origin PHP API. The default works on Namecheap.
VITE_API_BASE_URL=./api
VITE_TURNSTILE_SITE_KEY=
# Explicit local UI demo only; production never accepts demo orders.
VITE_DEMO_MODE=false
