{
  "name": "home-decor-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "build": "npm run seed-data && npm run prepare-assets && vite build && node scripts/package-backend.mjs",
    "package:namecheap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-namecheap.ps1",
    "seed-data": "node scripts/seed-data.mjs",
    "dev:backend": "node scripts/dev-backend.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "ffmpeg-static": "^5.2.0",
    "lucide": "^1.55.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
